{
  "name": "Outfit Visual Skill",
  "version": "1.2.0",
  "description": "Generate menswear and genderless outfit visuals from uploaded product references using six strong native visual contracts.",
  "repository": "https://github.com/rochyzhang/outfit-visual-skill",
  "supportedContentTypes": ["men", "genderless"],
  "unsupportedContentTypes": ["couple"],
  "modes": {
    "nativeAgent": {
      "default": true,
      "requiresMcp": false,
      "requiresSeparateProviderApiKey": false,
      "requiresCompatibleNativeImageGeneration": true,
      "summary": "Use the Skill directly with an Agent that already supports image generation or editing."
    },
    "studioMcp": {
      "optional": true,
      "requiresLocalStudio": true,
      "summary": "Optional advanced local workflow with registry tools, validation, asset IDs, history, revision/retry, and provider automation."
    }
  },
  "mcp": {
    "supported": true,
    "required": false,
    "transport": "stdio",
    "command": "pnpm run mcp:skills"
  },
  "tools": [
    "list_outfit_skills",
    "get_outfit_skill",
    "validate_outfit_skill",
    "execute_outfit_skill"
  ],
  "productFidelity": {
    "enabled": true,
    "canDisable": false,
    "summary": "Uploaded product references are authoritative and must be preserved."
  },
  "skills": [
    {
      "id": "SK01_MINIMAL_FLAT_LAY",
      "name": "Minimal Flat Lay",
      "code": "01",
      "referenceImage": "examples/visual/01-minimal-flat-lay.jpg"
    },
    {
      "id": "SK02_INVISIBLE_EDITORIAL",
      "name": "Clean Editorial Flat Lay",
      "code": "02",
      "referenceImage": "examples/visual/02-clean-editorial-flat-lay.png"
    },
    {
      "id": "SK03_LOOK_BREAKDOWN",
      "name": "Look Breakdown",
      "code": "03",
      "referenceImage": "examples/visual/03-look-breakdown.jpg"
    },
    {
      "id": "SK04_PROP_STYLING",
      "name": "Prop Styling",
      "code": "04",
      "referenceImage": "examples/visual/04-prop-styling.jpg"
    },
    {
      "id": "SK05_JAPANESE_CATALOG",
      "name": "Japanese Catalog",
      "code": "05",
      "referenceImage": "examples/visual/05-japanese-catalog.png"
    },
    {
      "id": "SK06_KOREAN_STREET_EDITORIAL",
      "name": "Korean Street Editorial",
      "code": "06",
      "referenceImage": "examples/visual/06-korean-street-editorial.jpg"
    }
  ],
  "safety": {
    "requiresExplicitAssetIdsInMcpMode": true,
    "allowsNativeReferenceInspection": true,
    "noAssetDiscoveryInMcpMode": true,
    "missingAssetsRemainEmpty": true,
    "englishGeneratedVisibleTextOnlyForCatalogGraphics": false,
    "sk05AllowsLimitedJapaneseEditorialAccentText": true,
    "sk06RequiresEnglishHandDrawnCalloutsOnly": true
  }
}
